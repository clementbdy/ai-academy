// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// Le contenu pédagogique (Domain/Module/Skill/Lesson/Exercise/Project/Tool)
// est statique et versionné dans src/content/ — pas en base.
// Seules les données utilisateur (progression, soumissions, notes...) sont
// persistées ici. Les champs skillId/exerciseId/projectId ci-dessous sont
// des identifiants texte qui pointent vers ce contenu statique, sans clé
// étrangère au niveau de la base (les deux couches sont indépendantes).

// --- Auth.js (schéma standard de l'adapter Prisma) ---

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String?   @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  accounts       Account[]
  sessions       Session[]

  skillProgress       SkillProgress[]
  activityLogs        ActivityLog[]
  exerciseSubmissions ExerciseSubmission[]
  projectSubmissions  ProjectSubmission[]
  notes               Note[]
  savedPrompts        SavedPrompt[]
  workflows           Workflow[]
  toolFavorites       ToolFavorite[]
  objectives          Objective[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SkillProgress {
  id        String   @id @default(cuid())
  userId    String
  skillId   String
  level     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model ActivityLog {
  id           String   @id @default(cuid())
  userId       String
  skillId      String
  activityId   String
  activityType String
  result       String?
  timeSpentSec Int?
  completedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([skillId])
  @@index([activityId])
}

model ExerciseSubmission {
  id              String   @id @default(cuid())
  userId          String
  exerciseId      String
  skillId         String
  content         String
  status          String   @default("draft")
  criteriaResults String?
  timeSpentSec    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([exerciseId])
  @@index([skillId])
}

model ProjectSubmission {
  id              String   @id @default(cuid())
  userId          String
  projectId       String
  content         String
  status          String   @default("draft")
  criteriaResults String?
  timeSpentSec    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([projectId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String
  content   String
  tags      String?
  skillId   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPrompt {
  id        String   @id @default(cuid())
  userId    String
  title     String
  prompt    String
  notes     String?
  tags      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Workflow {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  steps       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ToolFavorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
}

model Objective {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  targetDate  DateTime?
  status      String    @default("active")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
